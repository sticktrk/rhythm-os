#!/usr/bin/env bash
set -euo pipefail

# Project coverage gate for deterministic Rust business logic.
#
# cargo-llvm-cov is the installed llvm coverage runner in this environment.
# This wrapper keeps central command/event-loop/storage code in the denominator
# and excludes platform shells, network transports, and long-running service
# glue that is tracked by the raw workspace report but not gated here.

IGNORE_FILENAME_REGEX='(/app/flutter/rhythm_app/rust/src/frb_generated\.rs$|/rust/(bins|integrations)/|/rust/core/rhythm-os/src/(handlers|periodic|lifecycle|hub|mdns|room_sync|state|provisioning|logging|factory_default_config|axum_router|remote_access|activity_cloud)\.rs$|/rust/core/rhythm-profile/src/(render|config)\.rs$|/rust/core/rhythm-core/src/runtime/(adapters/thread|registry|hub_registry|executor)\.rs$)'
FAIL_UNDER_LINES="${ARGO_LLVM_COV_FAIL_UNDER_LINES:-90}"

exec cargo llvm-cov \
    --workspace \
    --ignore-filename-regex "${IGNORE_FILENAME_REGEX}" \
    --fail-under-lines "${FAIL_UNDER_LINES}" \
    "$@"
