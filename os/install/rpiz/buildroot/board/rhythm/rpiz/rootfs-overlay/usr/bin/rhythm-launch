#!/bin/sh

set -eu

LOGFILE=/var/log/rhythm-server.log
MATTER_LOGFILE_DEFAULT=/var/log/rhythm-matter.log
DATA_DIR=/data
DEV_DEFAULTS=/etc/default/rhythm-dev
BOOTSTATE_SCRIPT=/etc/init.d/S41bootstate
BOOT_SUCCESS_GRACE_SECS_DEFAULT=20

is_truthy() {
    case "${1:-}" in
        1|true|TRUE|yes|YES|on|ON) return 0 ;;
        *) return 1 ;;
    esac
}

mkdir -p "$(dirname "$LOGFILE")" "$DATA_DIR"

printf 'rhythm-launch: system time %s\n' "$(date -Iseconds 2>/dev/null || date)" >>"$LOGFILE"
if [ -w /dev/console ]; then
    printf 'rhythm-launch: system time %s\n' "$(date -Iseconds 2>/dev/null || date)" > /dev/console
fi

export RHYTHM_PLATFORM_TYPE=appliance
export RHYTHM_PLATFORM_CONTEXT=rpiz
export RHYTHM_MATTER_CHIPD=/usr/bin/rhythm-chipd

if [ -r "$DEV_DEFAULTS" ]; then
    # shellcheck disable=SC1090
    . "$DEV_DEFAULTS"
fi

# Keep raw Matter chipd output separate from the main appliance log by default.
# Set RHYTHM_MATTER_LOGFILE='' in /etc/default/rhythm-dev to merge it back.
export RHYTHM_MATTER_LOGFILE="${RHYTHM_MATTER_LOGFILE-$MATTER_LOGFILE_DEFAULT}"

if is_truthy "${RHYTHM_DEV_MODE:-}"; then
    export RHYTHM_DEV_MODE=1
    export RHYTHM_MATTER_BYPASS_DEVICE_ATTESTATION="${RHYTHM_MATTER_BYPASS_DEVICE_ATTESTATION:-1}"
fi

mark_boot_success() {
    if [ -x "$BOOTSTATE_SCRIPT" ]; then
        "$BOOTSTATE_SCRIPT" success >/dev/null 2>&1 || true
    fi
}

rollback_pending_boot() {
    if [ -x "$BOOTSTATE_SCRIPT" ]; then
        "$BOOTSTATE_SCRIPT" fail >/dev/null 2>&1 || true
    fi
}

boot_success_grace_secs() {
    case "${RHYTHM_BOOT_SUCCESS_GRACE_SECS:-$BOOT_SUCCESS_GRACE_SECS_DEFAULT}" in
        ''|*[!0-9]*)
            printf '%s\n' "$BOOT_SUCCESS_GRACE_SECS_DEFAULT"
            ;;
        *)
            printf '%s\n' "${RHYTHM_BOOT_SUCCESS_GRACE_SECS:-$BOOT_SUCCESS_GRACE_SECS_DEFAULT}"
            ;;
    esac
}

launch_server() {
    if [ -w /dev/console ]; then
        /bin/sh -c '/usr/bin/rhythm-server --data-dir "$1" --log-level info 2>&1 | tee -a "$2" /dev/console >/dev/null' sh "$DATA_DIR" "$LOGFILE" &
    else
        /bin/sh -c 'exec /usr/bin/rhythm-server --data-dir "$1" --log-level info >>"$2" 2>&1' sh "$DATA_DIR" "$LOGFILE" &
    fi
    SERVER_PID=$!
}

wait_for_server() {
    local grace_secs status

    grace_secs="$(boot_success_grace_secs)"
    while [ "$grace_secs" -gt 0 ]; do
        if ! kill -0 "$SERVER_PID" 2>/dev/null; then
            wait "$SERVER_PID"
            status=$?
            rollback_pending_boot
            return "$status"
        fi
        sleep 1
        grace_secs=$((grace_secs - 1))
    done

    mark_boot_success
    wait "$SERVER_PID"
}

launch_server
wait_for_server
