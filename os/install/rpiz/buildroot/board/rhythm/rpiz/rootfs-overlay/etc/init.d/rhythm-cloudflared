#!/bin/sh

set -eu

DEFAULTS="${RHYTHM_DEFAULTS:-/etc/default/rhythm}"
DEV_DEFAULTS="${RHYTHM_DEV_DEFAULTS:-/etc/default/rhythm-dev}"

if [ -r "$DEFAULTS" ]; then
    # shellcheck disable=SC1090
    . "$DEFAULTS"
fi

if [ -r "$DEV_DEFAULTS" ]; then
    # shellcheck disable=SC1090
    . "$DEV_DEFAULTS"
fi

DATA_DIR="${RHYTHM_DATA_DIR:-/data}"
CLOUDFLARED_BIN="${RHYTHM_CLOUDFLARED_BIN:-/usr/bin/cloudflared}"
TOKEN_FILE="${RHYTHM_CLOUDFLARED_TOKEN_FILE:-$DATA_DIR/cloudflared/connector_token}"
PROTOCOL="${RHYTHM_CLOUDFLARED_PROTOCOL:-http2}"
LOGLEVEL="${RHYTHM_CLOUDFLARED_LOGLEVEL:-warn}"
HA_CONNECTIONS="${RHYTHM_CLOUDFLARED_HA_CONNECTIONS:-1}"
# Zero means unlimited. The connector already uses capped exponential backoff;
# stopping permanently after a handful of exits strands an otherwise configured
# appliance until a reboot or app-side toggle.
MAX_RESTARTS="${RHYTHM_CLOUDFLARED_MAX_RESTARTS:-0}"
STOP_TIMEOUT_SECS="${RHYTHM_CLOUDFLARED_STOP_TIMEOUT_SECS:-5}"
VMEM_LIMIT_KB="${RHYTHM_CLOUDFLARED_VMEM_LIMIT_KB:-262144}"
NICE_LEVEL="${RHYTHM_CLOUDFLARED_NICE:-10}"
METRICS_ADDR="${RHYTHM_CLOUDFLARED_METRICS:-127.0.0.1:54449}"
PIDFILE="${RHYTHM_CLOUDFLARED_PIDFILE:-/var/run/rhythm-cloudflared.pid}"
CHILD_PIDFILE="${RHYTHM_CLOUDFLARED_CHILD_PIDFILE:-/var/run/rhythm-cloudflared-child.pid}"
STATUS_FILE="${RHYTHM_CLOUDFLARED_STATUS_FILE:-$DATA_DIR/cloudflared/status.env}"
BACKOFF_INITIAL_SECS="${RHYTHM_CLOUDFLARED_BACKOFF_INITIAL_SECS:-2}"
BACKOFF_MAX_SECS="${RHYTHM_CLOUDFLARED_BACKOFF_MAX_SECS:-60}"
LOG_DIR_DEFAULT=/data/log
LOG_DIR_FALLBACK=/var/log

resolve_log_dir() {
    if [ -n "${RHYTHM_LOG_DIR:-}" ]; then
        printf '%s\n' "$RHYTHM_LOG_DIR"
        return 0
    fi

    if grep -qs '[[:space:]]/data[[:space:]]' /proc/mounts 2>/dev/null; then
        printf '%s\n' "$LOG_DIR_DEFAULT"
    else
        printf '%s\n' "$LOG_DIR_FALLBACK"
    fi
}

LOGFILE="$(resolve_log_dir)/cloudflared.log"

case "$HA_CONNECTIONS" in ''|*[!0-9]*) HA_CONNECTIONS=1 ;; esac
case "$MAX_RESTARTS" in ''|*[!0-9]*) MAX_RESTARTS=0 ;; esac
case "$STOP_TIMEOUT_SECS" in ''|*[!0-9]*) STOP_TIMEOUT_SECS=5 ;; esac
case "$VMEM_LIMIT_KB" in ''|*[!0-9]*) VMEM_LIMIT_KB=262144 ;; esac
case "$NICE_LEVEL" in ''|*[!0-9]*) NICE_LEVEL=10 ;; esac

log() {
    mkdir -p "$(dirname "$LOGFILE")"
    printf 'cloudflared: %s\n' "$*" >> "$LOGFILE"
}

pid_is_running() {
    [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}

child_pid_is_running() {
    [ -f "$CHILD_PIDFILE" ] && kill -0 "$(cat "$CHILD_PIDFILE")" 2>/dev/null
}

pid_value_is_running() {
    [ -n "${1:-}" ] && kill -0 "$1" 2>/dev/null
}

wait_pid_exit() {
    pid="${1:-}"
    remaining="$STOP_TIMEOUT_SECS"
    while pid_value_is_running "$pid" && [ "$remaining" -gt 0 ]; do
        sleep 1 || true
        remaining=$((remaining - 1))
    done
    ! pid_value_is_running "$pid"
}

terminate_pid() {
    pid="${1:-}"
    label="${2:-process}"
    if ! pid_value_is_running "$pid"; then
        return 0
    fi

    kill "$pid" 2>/dev/null || true
    if wait_pid_exit "$pid"; then
        return 0
    fi

    log "$label pid=$pid did not exit after ${STOP_TIMEOUT_SECS}s; killing"
    kill -9 "$pid" 2>/dev/null || true
    wait_pid_exit "$pid" || true
}

# Pidfiles can go stale (a kill -9'd supervisor skips its cleanup trap and
# orphans the connector), leaving a tunnel that "won't go down". Sweep any
# process running the connector binary, regardless of recorded pids.
# The appliance busybox has no pkill/pgrep, so match /proc cmdlines directly.
connector_pids() {
    for proc_dir in /proc/[0-9]*; do
        [ -d "$proc_dir" ] || continue
        pid="${proc_dir#/proc/}"
        [ "$pid" = "$$" ] && continue
        [ -r "$proc_dir/cmdline" ] || continue
        cmdline="$(tr '\0' ' ' < "$proc_dir/cmdline" 2>/dev/null || true)"
        case " $cmdline " in
            *" $CLOUDFLARED_BIN "*) printf '%s\n' "$pid" ;;
        esac
    done
}

kill_stray_connectors() {
    pids="$(connector_pids)"
    [ -n "$pids" ] || return 0

    # shellcheck disable=SC2086
    log "terminating stray connector processes:" $pids
    for pid in $pids; do
        kill "$pid" 2>/dev/null || true
    done
    remaining="$STOP_TIMEOUT_SECS"
    while [ -n "$(connector_pids)" ] && [ "$remaining" -gt 0 ]; do
        sleep 1 || true
        remaining=$((remaining - 1))
    done
    for pid in $(connector_pids); do
        log "stray connector pid=$pid did not exit after ${STOP_TIMEOUT_SECS}s; killing"
        kill -9 "$pid" 2>/dev/null || true
    done
}

epoch_secs() {
    date +%s 2>/dev/null || printf '0\n'
}

write_status() {
    mkdir -p "$(dirname "$STATUS_FILE")"
    tmp="${STATUS_FILE}.$$"
    {
        printf 'state=%s\n' "${state:-unknown}"
        printf 'supervisor_pid=%s\n' "${supervisor_pid:-}"
        printf 'child_pid=%s\n' "${child_pid:-}"
        printf 'restart_count=%s\n' "${restart_count:-0}"
        printf 'last_started_epoch_secs=%s\n' "${last_started_epoch_secs:-}"
        printf 'last_exit_epoch_secs=%s\n' "${last_exit_epoch_secs:-}"
        printf 'last_exit_code=%s\n' "${last_exit_code:-}"
        printf 'next_restart_epoch_secs=%s\n' "${next_restart_epoch_secs:-}"
        printf 'metrics_addr=%s\n' "$METRICS_ADDR"
        printf 'protocol=%s\n' "$PROTOCOL"
        printf 'loglevel=%s\n' "$LOGLEVEL"
        printf 'ha_connections=%s\n' "$HA_CONNECTIONS"
        printf 'max_restarts=%s\n' "$MAX_RESTARTS"
        printf 'stop_timeout_secs=%s\n' "$STOP_TIMEOUT_SECS"
        printf 'vmem_limit_kb=%s\n' "$VMEM_LIMIT_KB"
    } > "$tmp"
    mv -f "$tmp" "$STATUS_FILE"
}

start_cloudflared_child() {
    (
        if [ "$VMEM_LIMIT_KB" != "0" ]; then
            ulimit -v "$VMEM_LIMIT_KB" 2>/dev/null || true
        fi

        if command -v nice >/dev/null 2>&1; then
            exec nice -n "$NICE_LEVEL" "$CLOUDFLARED_BIN" "$@"
        fi

        exec "$CLOUDFLARED_BIN" "$@"
    ) >>"$LOGFILE" 2>&1 &
    child_pid="$!"
}

launch_connector() {
    set -- tunnel --no-autoupdate --protocol "$PROTOCOL" --loglevel "$LOGLEVEL" --metrics "$METRICS_ADDR"
    if [ "$HA_CONNECTIONS" != "0" ]; then
        set -- "$@" --ha-connections "$HA_CONNECTIONS"
    fi
    # Keep the remotely-managed tunnel credential out of /proc/<pid>/cmdline.
    set -- "$@" run --token-file "$TOKEN_FILE"

    log "starting connector: protocol=$PROTOCOL metrics=$METRICS_ADDR ha_connections=${HA_CONNECTIONS:-default} vmem_limit_kb=$VMEM_LIMIT_KB"
    start_cloudflared_child "$@"
}

stop_child() {
    if child_pid_is_running; then
        kill "$(cat "$CHILD_PIDFILE")" 2>/dev/null || true
    fi
}

supervise() {
    supervisor_pid="$$"
    child_pid=""
    restart_count=0
    last_started_epoch_secs=""
    last_exit_epoch_secs=""
    last_exit_code=""
    next_restart_epoch_secs=""
    state="starting"
    write_status

    trap 'state=stopping; write_status; stop_child; state=stopped; child_pid=""; write_status; rm -f "$PIDFILE" "$CHILD_PIDFILE"; exit 0' INT TERM

    backoff="$BACKOFF_INITIAL_SECS"
    while [ -s "$TOKEN_FILE" ]; do
        launch_connector
        echo "$child_pid" > "$CHILD_PIDFILE"
        last_started_epoch_secs="$(epoch_secs)"
        state="running"
        next_restart_epoch_secs=""
        write_status

        set +e
        wait "$child_pid"
        last_exit_code="$?"
        set -e

        last_exit_epoch_secs="$(epoch_secs)"
        log "connector exited pid=$child_pid code=$last_exit_code"
        child_pid=""
        rm -f "$CHILD_PIDFILE"
        state="exited"
        write_status

        if [ ! -s "$TOKEN_FILE" ]; then
            break
        fi

        restart_count=$((restart_count + 1))
        if [ "$MAX_RESTARTS" != "0" ] && [ "$restart_count" -ge "$MAX_RESTARTS" ]; then
            log "connector restart limit reached restart_count=$restart_count max_restarts=$MAX_RESTARTS"
            state="failed"
            next_restart_epoch_secs=""
            write_status
            break
        fi

        next_restart_epoch_secs=$((last_exit_epoch_secs + backoff))
        state="backoff"
        write_status
        sleep "$backoff" || true
        if [ "$backoff" -lt "$BACKOFF_MAX_SECS" ]; then
            backoff=$((backoff * 2))
            if [ "$backoff" -gt "$BACKOFF_MAX_SECS" ]; then
                backoff="$BACKOFF_MAX_SECS"
            fi
        fi
    done

    if [ "$state" != "failed" ]; then
        state="stopped"
    fi
    child_pid=""
    next_restart_epoch_secs=""
    write_status
    rm -f "$PIDFILE" "$CHILD_PIDFILE"
}

start() {
    mkdir -p "$(dirname "$PIDFILE")" "$(dirname "$CHILD_PIDFILE")" "$(dirname "$STATUS_FILE")" "$(dirname "$LOGFILE")"

    if pid_is_running; then
        return 0
    fi

    if [ ! -x "$CLOUDFLARED_BIN" ]; then
        state="unavailable"
        supervisor_pid=""
        child_pid=""
        write_status
        log "binary not available at $CLOUDFLARED_BIN"
        return 0
    fi

    if [ ! -s "$TOKEN_FILE" ]; then
        state="not_configured"
        supervisor_pid=""
        child_pid=""
        write_status
        log "connector token not configured"
        return 0
    fi

    supervise >>"$LOGFILE" 2>&1 &
    echo "$!" > "$PIDFILE"
    log "started supervisor pid $(cat "$PIDFILE")"
}

stop() {
    supervisor_pid="$(cat "$PIDFILE" 2>/dev/null || true)"
    child_pid="$(cat "$CHILD_PIDFILE" 2>/dev/null || true)"

    if pid_value_is_running "$supervisor_pid"; then
        terminate_pid "$supervisor_pid" "supervisor"
    else
        terminate_pid "$child_pid" "connector"
    fi

    child_pid="${child_pid:-$(cat "$CHILD_PIDFILE" 2>/dev/null || true)}"
    terminate_pid "$child_pid" "connector"
    kill_stray_connectors

    rm -f "$PIDFILE" "$CHILD_PIDFILE"
    state="stopped"
    supervisor_pid=""
    child_pid=""
    write_status
}

case "${1:-}" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        stop
        start
        ;;
    status)
        if pid_is_running; then
            echo "running"
            exit 0
        fi
        echo "stopped"
        exit 1
        ;;
esac
