#!/bin/sh

BOOT_MOUNT=/boot
STATE_FILE="${BOOT_MOUNT}/rhythm-bootstate.env"
DATA_STATE_DIR=/data/ota
DATA_STATE_FILE="${DATA_STATE_DIR}/bootstate.env"
SERVER_BIN=/usr/bin/rhythm-server

current_slot() {
    local token

    for token in $(cat /proc/cmdline 2>/dev/null); do
        case "$token" in
            root=/dev/mmcblk0p2)
                printf 'a\n'
                return 0
                ;;
            root=/dev/mmcblk0p3)
                printf 'b\n'
                return 0
                ;;
        esac
    done

    return 1
}

current_version() {
    if [ ! -x "$SERVER_BIN" ]; then
        return 0
    fi

    "$SERVER_BIN" --version 2>/dev/null | awk 'NR==1 { print $2 }'
}

write_state() {
    local slot="$1"
    local pending_slot="$2"
    local pending_version="$3"
    local active_version="$4"

    cat > "$STATE_FILE" <<EOF
RHYTHM_ACTIVE_SLOT=$slot
RHYTHM_LAST_GOOD_SLOT=$slot
RHYTHM_PENDING_SLOT=$pending_slot
RHYTHM_PENDING_VERSION=$pending_version
RHYTHM_ACTIVE_VERSION=$active_version
EOF
}

mirror_state() {
    mkdir -p "$DATA_STATE_DIR"
    cp -f "$STATE_FILE" "$DATA_STATE_FILE"
}

start() {
    local slot pending_slot pending_version active_version

    slot="$(current_slot || true)"
    [ -n "$slot" ] || return 0

    pending_slot=""
    pending_version=""
    if [ -r "$STATE_FILE" ]; then
        # shellcheck disable=SC1090
        . "$STATE_FILE"
        pending_slot="${RHYTHM_PENDING_SLOT:-}"
        pending_version="${RHYTHM_PENDING_VERSION:-}"
    fi

    active_version="$(current_version || true)"
    if [ "$pending_slot" = "$slot" ]; then
        pending_slot=""
        pending_version=""
    fi

    write_state "$slot" "$pending_slot" "$pending_version" "$active_version"
    mirror_state
}

stop() {
    :
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        stop
        start
        ;;
esac
