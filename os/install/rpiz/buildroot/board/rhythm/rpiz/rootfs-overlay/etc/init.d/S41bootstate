#!/bin/sh

set -eu

BOOT_MOUNT="${RHYTHM_BOOT_MOUNT:-/boot}"
STATE_FILE="${RHYTHM_BOOTSTATE_FILE:-${BOOT_MOUNT}/rhythm-bootstate.env}"
STATE_BACKUP_FILE="${RHYTHM_BOOTSTATE_BACKUP_FILE:-${STATE_FILE}.bak}"
DATA_STATE_DIR="${RHYTHM_BOOTSTATE_DATA_DIR:-/data/ota}"
DATA_STATE_FILE="${RHYTHM_BOOTSTATE_DATA_FILE:-${DATA_STATE_DIR}/bootstate.env}"
DATA_DIR="${RHYTHM_DATA_DIR:-/data}"
ROLLBACK_REQUIRED_LATCH="${RHYTHM_BOOTSTATE_ROLLBACK_REQUIRED_LATCH:-/run/rhythm-rollback-required}"
SERVER_BIN="${RHYTHM_SERVER_BIN:-/usr/bin/rhythm-server}"
WIFI_INIT="${RHYTHM_BOOTSTATE_WIFI_INIT:-/etc/init.d/S42wifi}"
NETWORK_READY_PROBE="${RHYTHM_BOOTSTATE_NETWORK_READY_PROBE:-}"
NETWORK_WAIT_ATTEMPTS="${RHYTHM_BOOTSTATE_NETWORK_WAIT_ATTEMPTS:-15}"
NETWORK_WAIT_SLEEP_SECS="${RHYTHM_BOOTSTATE_NETWORK_WAIT_SLEEP_SECS:-1}"
CMDLINE_FILE="${RHYTHM_CMDLINE_FILE:-${BOOT_MOUNT}/cmdline.txt}"
PROC_CMDLINE="${RHYTHM_PROC_CMDLINE:-/proc/cmdline}"
BOARD_MODEL_FILE="${RHYTHM_BOARD_MODEL_FILE:-/proc/device-tree/model}"
PROC_MOUNTS="${RHYTHM_PROC_MOUNTS:-/proc/mounts}"
BLUETOOTH_UART_CONFIG="${BOOT_MOUNT}/config.txt"
BLUETOOTH_UART_BACKUP="${BLUETOOTH_UART_CONFIG}.pre-bluetooth-uart"
BLUETOOTH_UART_ORIGINAL="${BLUETOOTH_UART_BACKUP}.orig"
BLUETOOTH_UART_PENDING="${BOOT_MOUNT}/rhythm-bluetooth-uart.pending"
BLUETOOTH_UART_REBOOTS="${DATA_STATE_DIR}/bluetooth-uart-migration-reboots"
BLUETOOTH_UART_MAX_REBOOTS=2
# The one definition of the legacy directive: detection, removal and the
# post-removal verification must never disagree about what it matches.
BLUETOOTH_UART_DIRECTIVE='^[[:space:]]*dtoverlay[[:space:]]*=[[:space:]]*miniuart-bt[[:space:]]*(#.*)?$'
HASH_HEADER_PREFIX="# RHYTHM_BOOTSTATE_HASH="

now_ms() {
    date +%s 2>/dev/null | awk '{ printf "%s000\n", $1 }'
}

slot_device() {
    case "$1" in
        a) printf '/dev/mmcblk0p2\n' ;;
        b) printf '/dev/mmcblk0p3\n' ;;
        *) return 1 ;;
    esac
}

hash_file() {
    local path="$1"

    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$path" | awk '{ print $1 }'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$path" | awk '{ print $1 }'
    elif command -v openssl >/dev/null 2>&1; then
        openssl dgst -sha256 "$path" | awk '{ print $NF }'
    else
        return 1
    fi
}

sync_path() {
    sync "$1" 2>/dev/null || sync
}

sync_parent() {
    local parent

    parent="$(dirname "$1")"
    sync "$parent" 2>/dev/null || sync
}

scrub_local_ble_rollback_state() {
    local data_dir

    data_dir="$DATA_DIR"
    while [ "${data_dir%/}" != "$data_dir" ]; do
        data_dir="${data_dir%/}"
    done
    case "$data_dir" in
        /*) ;;
        *)
            printf 'S41bootstate: refusing local BLE rollback scrub outside an absolute data directory: %s\n' "$DATA_DIR" >&2
            return 1
            ;;
    esac
    case "$data_dir" in
        ""|/|*/../*|*/..|*/./*|*/.)
            printf 'S41bootstate: refusing unsafe local BLE rollback data directory: %s\n' "$DATA_DIR" >&2
            return 1
            ;;
    esac
    if [ ! -d "$data_dir" ] || [ -L "$data_dir" ]; then
        printf 'S41bootstate: local BLE rollback data path is not a real directory: %s\n' "$data_dir" >&2
        return 1
    fi

    rm -rf \
        "$data_dir/local_ble" \
        "$data_dir/aidot_ble"
    rm -f \
        "$data_dir/pairing_history.json" \
        "$data_dir/pairing_history.json.tmp" \
        "$data_dir/pairing_metadata.json" \
        "$data_dir/pairing_metadata.json.tmp" \
        "$data_dir/server_metadata.json.tmp"
    sync_path "$data_dir"
}

rollback_network_ready() {
    if [ -n "$NETWORK_READY_PROBE" ]; then
        [ -x "$NETWORK_READY_PROBE" ] && "$NETWORK_READY_PROBE"
        return
    fi

    ifconfig -a 2>/dev/null | awk '
        $1 == "inet" {
            address = $2
            sub(/^addr:/, "", address)
            if (address != "0.0.0.0" && address !~ /^127\./) {
                found = 1
            }
        }
        END { exit(found ? 0 : 1) }
    '
}

wait_for_rollback_network() {
    local attempt

    case "$NETWORK_WAIT_ATTEMPTS" in
        ""|*[!0-9]*)
            printf 'S41bootstate: invalid rollback network wait attempt count: %s\n' "$NETWORK_WAIT_ATTEMPTS" >&2
            return 1
            ;;
    esac
    case "$NETWORK_WAIT_SLEEP_SECS" in
        ""|*[!0-9]*)
            printf 'S41bootstate: invalid rollback network wait interval: %s\n' "$NETWORK_WAIT_SLEEP_SECS" >&2
            return 1
            ;;
    esac

    attempt=1
    while [ "$attempt" -le "$NETWORK_WAIT_ATTEMPTS" ]; do
        if rollback_network_ready; then
            return 0
        fi
        if [ "$attempt" -lt "$NETWORK_WAIT_ATTEMPTS" ]; then
            sleep "$NETWORK_WAIT_SLEEP_SECS"
        fi
        attempt=$((attempt + 1))
    done

    printf 'S41bootstate: network did not become ready after %s checks\n' "$NETWORK_WAIT_ATTEMPTS" >&2
    return 1
}

bring_up_rollback_network() {
    if [ ! -x "$WIFI_INIT" ]; then
        printf 'S41bootstate: Wi-Fi init is unavailable during Hue rollback preparation\n' >&2
        return 1
    fi
    if ! "$WIFI_INIT" start; then
        printf 'S41bootstate: Wi-Fi init failed during Hue rollback preparation\n' >&2
        return 1
    fi
    wait_for_rollback_network
}

restore_hue_before_rollback() {
    if ! bring_up_rollback_network; then
        # The restore helper owns the durable manifest check. It must still run
        # after a bounded network wait so an offline appliance with no managed
        # Hue state can roll back, while a real pending restore fails closed.
        printf 'S41bootstate: network readiness unavailable; running the Hue rollback check before changing slots\n' >&2
    fi
    if [ ! -x "$SERVER_BIN" ]; then
        printf 'S41bootstate: cannot restore Hue controller state; server binary is unavailable\n' >&2
        return 1
    fi
    "$SERVER_BIN" --data-dir "$DATA_DIR" --restore-hue-before-rollback
}

atomic_write_text() {
    local target="$1"
    local text="$2"
    local tmp="${target}.tmp.$$"

    mkdir -p "$(dirname "$target")"
    printf '%s\n' "$text" > "$tmp"
    sync_path "$tmp"
    mv -f "$tmp" "$target"
    sync_parent "$target"
}

arm_rollback_required() {
    # Same-boot latch first: even if persistent bootstate cannot be written,
    # a respawned candidate must not later promote itself to last-good.
    atomic_write_text "$ROLLBACK_REQUIRED_LATCH" "rollback_required"
    RHYTHM_BOOT_STATUS="rollback_required"
    write_state
    mirror_state
}

bootstate_hash_valid() {
    local path="$1"
    local header expected actual body_tmp

    [ -r "$path" ] || return 1
    header="$(sed -n '1p' "$path" 2>/dev/null || true)"
    case "$header" in
        "$HASH_HEADER_PREFIX"*) ;;
        *) return 1 ;;
    esac

    expected="$(printf '%s\n' "$header" | sed 's/^# RHYTHM_BOOTSTATE_HASH=//')"
    body_tmp="/tmp/rhythm-bootstate-body.$$"
    tail -n +2 "$path" > "$body_tmp"
    actual="$(hash_file "$body_tmp" || true)"
    rm -f "$body_tmp"

    [ -n "$actual" ] && [ "$actual" = "$expected" ]
}

source_bootstate_file() {
    local path="$1"
    local header body_tmp

    [ -r "$path" ] || return 1
    header="$(sed -n '1p' "$path" 2>/dev/null || true)"
    case "$header" in
        "$HASH_HEADER_PREFIX"*)
            bootstate_hash_valid "$path" || return 1
            body_tmp="/tmp/rhythm-bootstate-source.$$"
            tail -n +2 "$path" > "$body_tmp"
            # shellcheck disable=SC1090
            . "$body_tmp"
            rm -f "$body_tmp"
            ;;
        *)
            # Legacy pre-hash bootstate; accepted so older appliances can
            # upgrade and immediately rewrite a hashed primary+backup.
            # shellcheck disable=SC1090
            . "$path"
            ;;
    esac
}

current_slot() {
    local token

    for token in $(cat "$PROC_CMDLINE" 2>/dev/null); do
        case "$token" in
            root=/dev/mmcblk0p2)
                printf 'a\n'
                return 0
                ;;
            root=/dev/mmcblk0p3)
                printf 'b\n'
                return 0
                ;;
        esac
    done

    return 1
}

current_version() {
    if [ ! -x "$SERVER_BIN" ]; then
        return 0
    fi

    "$SERVER_BIN" --version 2>/dev/null | awk 'NR==1 { print $2 }'
}

load_state() {
    RHYTHM_ACTIVE_SLOT=""
    RHYTHM_LAST_GOOD_SLOT=""
    RHYTHM_PENDING_SLOT=""
    RHYTHM_PENDING_VERSION=""
    RHYTHM_ACTIVE_VERSION=""
    RHYTHM_BOOT_STATUS="idle"
    RHYTHM_LAST_UPDATE_EPOCH_MS=""
    RHYTHM_LAST_ROLLBACK_SLOT=""
    RHYTHM_LAST_ROLLBACK_VERSION=""
    RHYTHM_LAST_ROLLBACK_EPOCH_MS=""

    source_bootstate_file "$STATE_FILE" || source_bootstate_file "$STATE_BACKUP_FILE" || true
}

compose_state_body() {
    cat <<EOF
RHYTHM_ACTIVE_SLOT=${RHYTHM_ACTIVE_SLOT:-}
RHYTHM_LAST_GOOD_SLOT=${RHYTHM_LAST_GOOD_SLOT:-}
RHYTHM_PENDING_SLOT=${RHYTHM_PENDING_SLOT:-}
RHYTHM_PENDING_VERSION=${RHYTHM_PENDING_VERSION:-}
RHYTHM_ACTIVE_VERSION=${RHYTHM_ACTIVE_VERSION:-}
RHYTHM_BOOT_STATUS=${RHYTHM_BOOT_STATUS:-idle}
RHYTHM_LAST_UPDATE_EPOCH_MS=${RHYTHM_LAST_UPDATE_EPOCH_MS:-}
RHYTHM_LAST_ROLLBACK_SLOT=${RHYTHM_LAST_ROLLBACK_SLOT:-}
RHYTHM_LAST_ROLLBACK_VERSION=${RHYTHM_LAST_ROLLBACK_VERSION:-}
RHYTHM_LAST_ROLLBACK_EPOCH_MS=${RHYTHM_LAST_ROLLBACK_EPOCH_MS:-}
EOF
}

write_state_file() {
    local target="$1"
    local body_tmp tmp hash

    mkdir -p "$(dirname "$target")"
    body_tmp="/tmp/rhythm-bootstate-body.$$"
    tmp="${target}.tmp.$$"

    compose_state_body > "$body_tmp"
    hash="$(hash_file "$body_tmp")" || {
        rm -f "$body_tmp" "$tmp"
        return 1
    }

    {
        printf '%s%s\n' "$HASH_HEADER_PREFIX" "$hash"
        cat "$body_tmp"
    } > "$tmp"

    rm -f "$body_tmp"
    sync_path "$tmp"
    mv -f "$tmp" "$target"
    sync_parent "$target"
}

write_state() {
    write_state_file "$STATE_BACKUP_FILE"
    write_state_file "$STATE_FILE"
}

mirror_state() {
    mkdir -p "$DATA_STATE_DIR"
    if [ -r "$STATE_FILE" ]; then
        cp -f "$STATE_FILE" "$DATA_STATE_FILE"
    elif [ -r "$STATE_BACKUP_FILE" ]; then
        cp -f "$STATE_BACKUP_FILE" "$DATA_STATE_FILE"
    else
        return 0
    fi
    sync_path "$DATA_STATE_FILE"
    sync_parent "$DATA_STATE_FILE"
}

rewrite_cmdline_slot() {
    local target_slot="$1"
    local target_root current_cmdline rewritten token found_root

    target_root="$(slot_device "$target_slot")"
    current_cmdline="$(cat "$CMDLINE_FILE" 2>/dev/null || true)"
    [ -n "$current_cmdline" ] || return 1

    rewritten=""
    found_root=0
    for token in $current_cmdline; do
        case "$token" in
            root=*)
                token="root=$target_root"
                found_root=1
                ;;
        esac
        if [ -n "$rewritten" ]; then
            rewritten="$rewritten $token"
        else
            rewritten="$token"
        fi
    done

    [ "$found_root" -eq 1 ] || return 1

    atomic_write_text "${CMDLINE_FILE}.bak" "$current_cmdline"
    atomic_write_text "$CMDLINE_FILE" "$rewritten"
}

reboot_now() {
    sync
    if [ -n "${RHYTHM_BOOTSTATE_REBOOT_DRY_RUN:-}" ]; then
        return 0
    fi
    if [ -n "${RHYTHM_BOOTSTATE_REBOOT_BIN:-}" ]; then
        "$RHYTHM_BOOTSTATE_REBOOT_BIN"
        return
    fi
    /sbin/reboot 2>/dev/null || reboot
}

is_regular_file() {
    [ -f "$1" ] && [ ! -L "$1" ]
}

remount_if_mounted() {
    local mode="$1"
    local path="$2"

    grep -qs "[[:space:]]${path}[[:space:]]" "$PROC_MOUNTS" 2>/dev/null || return 0
    mount -o "remount,${mode}" "$path" 2>/dev/null || true
}

# A forced reboot skips rcK and "umount -a -r". Flush and freeze the writable
# filesystems first so neither the rewritten boot partition nor /data is left
# dirty by the migration.
force_reboot_cleanly() {
    sync
    remount_if_mounted ro "$BOOT_MOUNT"
    remount_if_mounted ro "$DATA_DIR"
    sync
    if [ -n "${RHYTHM_BOOTSTATE_REBOOT_BIN:-}" ]; then
        "$RHYTHM_BOOTSTATE_REBOOT_BIN" -f || true
    elif ! /sbin/reboot -f 2>/dev/null; then
        reboot -f || true
    fi
    # Only reached when the reboot did not happen; the boot continues.
    remount_if_mounted rw "$BOOT_MOUNT"
    remount_if_mounted rw "$DATA_DIR"
}

count_lines() {
    grep -c '' "$1" 2>/dev/null || true
}

clear_bluetooth_uart_reboots() {
    [ -e "$BLUETOOTH_UART_REBOOTS" ] || return 0
    rm -f "$BLUETOOTH_UART_REBOOTS" 2>/dev/null || true
}

# Bounds migration reboots. The counter lives on /data, not /boot: if the boot
# partition silently fails to persist the rewrite, a marker beside it would be
# lost in the same way and the appliance would reboot forever.
record_bluetooth_uart_reboot() {
    local count

    count="$(cat "$BLUETOOTH_UART_REBOOTS" 2>/dev/null || true)"
    case "$count" in
        ""|*[!0-9]*) count=0 ;;
    esac
    [ "$count" -lt "$BLUETOOTH_UART_MAX_REBOOTS" ] || return 1
    atomic_write_text "$BLUETOOTH_UART_REBOOTS" "$((count + 1))" 2>/dev/null
}

# Rootfs-slot OTA deliberately preserves the shared boot partition. Migrate
# only our old, unparameterized mini-UART directive; replacing config.txt with
# the image template would discard unrelated boot settings.
#
# $1 is "<slot>:<version>" when this boot is an unproven OTA candidate, which
# ties the change to its probation: success commits it and rollback restores
# the previous config.txt, so the prior image resumes exactly the boot
# configuration it was qualified with.
# Returns 10 only after a durable change, 0 for no change, 1 on failure.
migrate_bluetooth_uart() {
    local candidate="${1:-}"
    local model config backup tmp backup_tmp source total matched remaining

    [ -r "$BOARD_MODEL_FILE" ] || return 0
    model="$(tr -d '\000' < "$BOARD_MODEL_FILE" 2>/dev/null || true)"
    case "$model" in
        "Raspberry Pi Zero W"|"Raspberry Pi Zero W "*) ;;
        *) return 0 ;;
    esac

    config="$BLUETOOTH_UART_CONFIG"
    backup="$BLUETOOTH_UART_BACKUP"
    tmp="${config}.tmp.$$"
    backup_tmp="${backup}.tmp.$$"

    if [ -L "$backup" ] || { [ -e "$backup" ] && [ ! -f "$backup" ]; }; then
        printf 'S41bootstate: refusing non-regular Bluetooth UART backup\n' >&2
        return 1
    fi

    if [ ! -e "$config" ] && [ ! -L "$config" ]; then
        # FAT cannot replace a file atomically. If power was lost while
        # config.txt was being swapped, rebuild it from our own backup.
        [ -s "$backup" ] || return 0
        printf 'S41bootstate: config.txt is missing; rebuilding it from the Bluetooth UART backup\n' >&2
        source="$backup"
    elif is_regular_file "$config"; then
        if ! grep -Eq "$BLUETOOTH_UART_DIRECTIVE" "$config"; then
            clear_bluetooth_uart_reboots
            return 0
        fi
        source="$config"
    else
        return 0
    fi

    if ! sed -E "/${BLUETOOTH_UART_DIRECTIVE}/d" "$source" > "$tmp"; then
        rm -f "$tmp"
        printf 'S41bootstate: failed to migrate Bluetooth UART; inspect config.txt and its pre-bluetooth-uart backup\n' >&2
        return 1
    fi

    # Prove the rewrite before committing to a reboot: the directive is gone
    # and every other line survived. A rewrite that changed nothing would
    # otherwise reboot on every boot.
    total="$(count_lines "$source")"
    matched="$(grep -Ec "$BLUETOOTH_UART_DIRECTIVE" "$source" 2>/dev/null || true)"
    remaining="$(count_lines "$tmp")"
    if grep -Eq "$BLUETOOTH_UART_DIRECTIVE" "$tmp" \
        || [ -z "$total" ] || [ -z "$matched" ] || [ -z "$remaining" ] \
        || [ "$remaining" -ne "$((total - matched))" ]; then
        rm -f "$tmp"
        printf 'S41bootstate: Bluetooth UART rewrite failed verification; leaving config.txt unchanged\n' >&2
        return 1
    fi

    if [ "$source" = "$config" ]; then
        # Keep the first config.txt we ever replaced: a repeated migration
        # refreshes the rollback copy but must not destroy the original.
        if [ -s "$backup" ] && [ ! -e "$BLUETOOTH_UART_ORIGINAL" ] \
            && [ ! -L "$BLUETOOTH_UART_ORIGINAL" ] \
            && ! cmp -s "$backup" "$config"; then
            if ! cp "$backup" "${BLUETOOTH_UART_ORIGINAL}.tmp.$$" \
                || ! sync_path "${BLUETOOTH_UART_ORIGINAL}.tmp.$$" \
                || ! mv -f "${BLUETOOTH_UART_ORIGINAL}.tmp.$$" "$BLUETOOTH_UART_ORIGINAL" \
                || ! sync_parent "$BLUETOOTH_UART_ORIGINAL"; then
                rm -f "$tmp" "${BLUETOOTH_UART_ORIGINAL}.tmp.$$"
                printf 'S41bootstate: failed to preserve the original Bluetooth UART backup\n' >&2
                return 1
            fi
        fi
        if ! cp "$config" "$backup_tmp" \
            || ! sync_path "$backup_tmp" \
            || ! mv -f "$backup_tmp" "$backup" \
            || ! sync_parent "$backup"; then
            rm -f "$tmp" "$backup_tmp"
            printf 'S41bootstate: failed to migrate Bluetooth UART; inspect config.txt and its pre-bluetooth-uart backup\n' >&2
            return 1
        fi
    fi

    if [ -n "$candidate" ]; then
        if ! atomic_write_text "$BLUETOOTH_UART_PENDING" "$candidate"; then
            rm -f "$tmp"
            printf 'S41bootstate: failed to record the pending Bluetooth UART migration\n' >&2
            return 1
        fi
    fi

    if ! sync_path "$tmp" \
        || ! mv -f "$tmp" "$config" \
        || ! sync_parent "$config"; then
        rm -f "$tmp"
        printf 'S41bootstate: failed to migrate Bluetooth UART; inspect config.txt and its pre-bluetooth-uart backup\n' >&2
        return 1
    fi
    return 10
}

# The migration is proven once its candidate passes probation (or when it ran
# on an already trusted slot); nothing may undo it after that.
commit_bluetooth_uart_migration() {
    [ -e "$BLUETOOTH_UART_PENDING" ] || [ -L "$BLUETOOTH_UART_PENDING" ] || return 0
    rm -f "$BLUETOOTH_UART_PENDING" 2>/dev/null || return 1
    sync_parent "$BLUETOOTH_UART_PENDING"
}

# Undo only the change made by the candidate that is being rolled back. Never
# fatal: a failed restore must not keep the appliance on a bad candidate, and
# the default routing is still a bootable configuration.
restore_bluetooth_uart_before_rollback() {
    local candidate="$1"
    local recorded tmp

    is_regular_file "$BLUETOOTH_UART_PENDING" || return 0
    recorded="$(sed -n '1p' "$BLUETOOTH_UART_PENDING" 2>/dev/null || true)"
    if [ "$recorded" != "$candidate" ]; then
        # Left behind by an earlier candidate that has since been decided.
        commit_bluetooth_uart_migration || true
        return 0
    fi
    if ! is_regular_file "$BLUETOOTH_UART_BACKUP" || [ ! -s "$BLUETOOTH_UART_BACKUP" ]; then
        printf 'S41bootstate: no Bluetooth UART backup to restore; keeping the default routing\n' >&2
        return 1
    fi

    tmp="${BLUETOOTH_UART_CONFIG}.tmp.$$"
    if ! cp "$BLUETOOTH_UART_BACKUP" "$tmp" \
        || ! sync_path "$tmp" \
        || ! mv -f "$tmp" "$BLUETOOTH_UART_CONFIG" \
        || ! sync_parent "$BLUETOOTH_UART_CONFIG"; then
        rm -f "$tmp"
        printf 'S41bootstate: failed to restore config.txt from the Bluetooth UART backup\n' >&2
        return 1
    fi
    clear_bluetooth_uart_reboots
    commit_bluetooth_uart_migration || true
    printf 'S41bootstate: restored the previous Bluetooth UART routing for rollback\n'
}

rollback_pending_boot() {
    local slot="$1"
    local active_version="$2"
    local rollback_to rollback_version

    rollback_to="${RHYTHM_LAST_GOOD_SLOT:-}"
    [ -n "$rollback_to" ] || return 0
    [ "$rollback_to" != "$slot" ] || return 0

    rollback_version="${RHYTHM_PENDING_VERSION:-}"
    arm_rollback_required
    # An older slot cannot safely read or reset local-BLE state. Erase and
    # durably commit that compatibility boundary before changing boot target.
    # Any failure leaves the candidate slot armed so the next attempt retries
    # instead of handing sensitive state to the previous binary.
    restore_hue_before_rollback
    scrub_local_ble_rollback_state
    restore_bluetooth_uart_before_rollback "${slot}:${rollback_version}" || true
    rewrite_cmdline_slot "$rollback_to"

    RHYTHM_ACTIVE_SLOT="$slot"
    RHYTHM_PENDING_SLOT=""
    RHYTHM_PENDING_VERSION=""
    RHYTHM_ACTIVE_VERSION="$active_version"
    RHYTHM_BOOT_STATUS="idle"
    RHYTHM_LAST_ROLLBACK_SLOT="$slot"
    RHYTHM_LAST_ROLLBACK_VERSION="$rollback_version"
    RHYTHM_LAST_ROLLBACK_EPOCH_MS="$(now_ms)"
    write_state
    mirror_state
    reboot_now
}

start() {
    local slot active_version uart_migration_status uart_candidate

    slot="$(current_slot || true)"
    [ -n "$slot" ] || return 0

    load_state
    active_version="$(current_version || true)"

    if [ "${RHYTHM_PENDING_SLOT:-}" = "$slot" ]; then
        case "${RHYTHM_BOOT_STATUS:-idle}" in
            booting|rollback_required)
                rollback_pending_boot "$slot" "$active_version"
                return 0
                ;;
        esac
    fi

    # A failed candidate must still roll back above. For a fresh candidate,
    # activate the boot-only change BEFORE marking it booting: the migration
    # reboot must not look like a failed probation boot. Removing the directive
    # makes this idempotent even if power is lost before the reboot call.
    uart_candidate=""
    if [ "${RHYTHM_PENDING_SLOT:-}" = "$slot" ]; then
        uart_candidate="${slot}:${RHYTHM_PENDING_VERSION:-}"
    fi
    uart_migration_status=0
    migrate_bluetooth_uart "$uart_candidate" || uart_migration_status=$?
    if [ "$uart_migration_status" -eq 10 ]; then
        if record_bluetooth_uart_reboot; then
            printf 'S41bootstate: restored default PL011 Bluetooth routing; rebooting before OTA probation\n'
            sync
            if [ -n "${RHYTHM_BOOTSTATE_REBOOT_DRY_RUN:-}" ]; then
                return 0
            fi
            # Early boot, before network/server startup. A direct reboot avoids
            # launching a candidate against the old UART while init shuts down.
            force_reboot_cleanly
            printf 'S41bootstate: Bluetooth UART reboot returned; continuing boot with correction pending\n' >&2
        else
            printf 'S41bootstate: Bluetooth UART migration reboot limit reached or unrecordable; continuing boot with correction pending\n' >&2
        fi
    fi

    if [ "${RHYTHM_PENDING_SLOT:-}" = "$slot" ]; then
        RHYTHM_ACTIVE_SLOT="$slot"
        [ -n "${RHYTHM_LAST_GOOD_SLOT:-}" ] || RHYTHM_LAST_GOOD_SLOT="$slot"
        RHYTHM_ACTIVE_VERSION="$active_version"
        RHYTHM_BOOT_STATUS="booting"
        write_state
        mirror_state
        return 0
    fi

    RHYTHM_ACTIVE_SLOT="$slot"
    RHYTHM_LAST_GOOD_SLOT="$slot"
    RHYTHM_PENDING_SLOT=""
    RHYTHM_PENDING_VERSION=""
    RHYTHM_ACTIVE_VERSION="$active_version"
    RHYTHM_BOOT_STATUS="idle"
    write_state
    mirror_state
    # No candidate is on probation, so no migration can still be undone.
    commit_bluetooth_uart_migration || true
}

success() {
    local slot active_version

    slot="$(current_slot || true)"
    [ -n "$slot" ] || return 0

    load_state
    if [ -e "$ROLLBACK_REQUIRED_LATCH" ] || [ "${RHYTHM_BOOT_STATUS:-idle}" = "rollback_required" ]; then
        printf 'S41bootstate: rollback is required; refusing to mark pending slot successful\n' >&2
        return 1
    fi
    [ "${RHYTHM_PENDING_SLOT:-}" = "$slot" ] || return 0

    active_version="$(current_version || true)"
    if [ -n "${RHYTHM_PENDING_VERSION:-}" ] && [ "$active_version" != "$RHYTHM_PENDING_VERSION" ]; then
        printf 'S41bootstate: running version %s does not match pending version %s; leaving rollback armed\n' "$active_version" "$RHYTHM_PENDING_VERSION" >&2
        return 1
    fi

    RHYTHM_ACTIVE_SLOT="$slot"
    RHYTHM_LAST_GOOD_SLOT="$slot"
    RHYTHM_PENDING_SLOT=""
    RHYTHM_PENDING_VERSION=""
    RHYTHM_ACTIVE_VERSION="$active_version"
    RHYTHM_BOOT_STATUS="idle"
    write_state
    mirror_state
    commit_bluetooth_uart_migration || true
}

fail() {
    local slot active_version

    slot="$(current_slot || true)"
    [ -n "$slot" ] || return 0

    load_state
    [ "${RHYTHM_PENDING_SLOT:-}" = "$slot" ] || return 0

    active_version="$(current_version || true)"
    rollback_pending_boot "$slot" "$active_version"
}

stop() {
    :
}

case "${1:-}" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        stop
        start
        ;;
    success)
        success
        ;;
    fail)
        fail
        ;;
esac
