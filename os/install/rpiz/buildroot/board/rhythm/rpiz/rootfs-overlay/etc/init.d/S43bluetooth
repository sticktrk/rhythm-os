#!/bin/sh

DEV_DEFAULTS=/etc/default/rhythm-dev
LOG_DIR_DEFAULT=/data/log
LOG_DIR_FALLBACK=/var/log
LOGFILE=
HCIATTACH="${HCIATTACH:-/usr/bin/hciattach}"
HCICONFIG="${HCICONFIG:-/usr/bin/hciconfig}"
HCI_READY_ATTEMPTS="${HCI_READY_ATTEMPTS:-20}"
HCI_READY_SLEEP_SECONDS="${HCI_READY_SLEEP_SECONDS:-1}"
BLUETOOTHD_INIT=/etc/init.d/S40bluetoothd
BLUETOOTH_STATE_SOURCE=/data/bluetooth
BLUETOOTH_STATE_TARGET=/var/lib/bluetooth
BLUETOOTH_MIGRATION_MARKER=/data/.bluetooth-state-migrated

resolve_log_dir() {
    if [ -n "${RHYTHM_LOG_DIR:-}" ]; then
        printf '%s\n' "$RHYTHM_LOG_DIR"
        return 0
    fi

    if grep -qs '[[:space:]]/data[[:space:]]' /proc/mounts 2>/dev/null; then
        printf '%s\n' "$LOG_DIR_DEFAULT"
    else
        printf '%s\n' "$LOG_DIR_FALLBACK"
    fi
}

if [ -r "$DEV_DEFAULTS" ]; then
    # shellcheck disable=SC1090
    . "$DEV_DEFAULTS"
fi

LOGFILE="$(resolve_log_dir)/bluetooth.log"

log() {
    local msg="bluetooth: $*"
    mkdir -p "$(dirname "$LOGFILE")"
    printf '%s\n' "$msg" >> "$LOGFILE"
    if [ -w /dev/console ]; then
        printf '%s\n' "$msg" > /dev/console
    fi
}

read_dt_value() {
    tr -d '\000' < "$1" 2>/dev/null || true
}

log_kernel_excerpt() {
    local lines

    lines="$(dmesg 2>/dev/null | grep -E 'Bluetooth:|hci0:|BCM43430|btuart|hci_uart' | tail -n 20 || true)"
    if [ -n "$lines" ]; then
        printf '%s\n' "$lines" | while IFS= read -r line; do
            log "kernel: $line"
        done
    fi
}

compute_bdaddr() {
    local serial b1 b2 b3

    if grep -q "raspberrypi,4" /proc/device-tree/compatible 2>/dev/null; then
        return 1
    fi

    serial="$(read_dt_value /proc/device-tree/serial-number | cut -c9-)"
    [ -n "$serial" ] || return 1

    b1="$(printf '%s' "$serial" | cut -c3-4)"
    b2="$(printf '%s' "$serial" | cut -c5-6)"
    b3="$(printf '%s' "$serial" | cut -c7-8)"
    printf 'b8:27:eb:%02x:%02x:%02x' $((0x$b1 ^ 0xaa)) $((0x$b2 ^ 0xaa)) $((0x$b3 ^ 0xaa))
}

attach_controller() {
    local uart0 serial1 uart0_pins serial_dev speed flow bdaddr

    if [ ! -x "$HCIATTACH" ]; then
        log "hciattach not installed; skipping UART attach"
        return 0
    fi

    if dmesg 2>/dev/null | grep -q -E 'hci[0-9]+: BCM: chip'; then
        log "kernel already attached the Bluetooth controller"
        return 0
    fi

    serial_dev=/dev/serial1
    if [ ! -c "$serial_dev" ]; then
        if [ -c /dev/ttyS0 ]; then
            serial_dev=/dev/ttyS0
        else
            log "no serial device found for Bluetooth UART attach"
            return 1
        fi
    fi

    uart0="$(read_dt_value /proc/device-tree/aliases/uart0)"
    serial1="$(read_dt_value /proc/device-tree/aliases/serial1)"

    if [ "$uart0" = "$serial1" ] && [ -n "$uart0" ]; then
        uart0_pins="$(wc -c /proc/device-tree/soc/gpio@7e200000/uart0_pins/brcm,pins 2>/dev/null | cut -d ' ' -f1)"
        if [ "$uart0_pins" = "16" ]; then
            speed=3000000
            flow=flow
        else
            speed=921600
            flow=noflow
        fi
    else
        speed=460800
        flow=noflow
    fi

    bdaddr="$(compute_bdaddr || true)"
    log "attaching BCM controller on $serial_dev speed=$speed flow=$flow"
    if [ -n "$bdaddr" ]; then
        "$HCIATTACH" "$serial_dev" bcm43xx "$speed" "$flow" - "$bdaddr" >>"$LOGFILE" 2>&1
    else
        "$HCIATTACH" "$serial_dev" bcm43xx "$speed" "$flow" - >>"$LOGFILE" 2>&1
    fi
}

wait_for_hci_ready() {
    local attempt=1

    if [ ! -x "$HCICONFIG" ]; then
        log "hciconfig is unavailable; cannot verify Bluetooth controller readiness"
        return 2
    fi

    while [ "$attempt" -le "$HCI_READY_ATTEMPTS" ]; do
        if "$HCICONFIG" hci0 >/dev/null 2>&1 \
            && "$HCICONFIG" hci0 up >>"$LOGFILE" 2>&1 \
            && "$HCICONFIG" hci0 2>/dev/null | grep -q 'UP RUNNING'; then
            log "Bluetooth controller hci0 is ready (attempt $attempt)"
            return 0
        fi
        sleep "$HCI_READY_SLEEP_SECONDS"
        attempt=$((attempt + 1))
    done

    log "Bluetooth controller hci0 did not become ready after $HCI_READY_ATTEMPTS attempts"
    return 1
}

migrate_legacy_bluetooth_state() {
    if [ -e "$BLUETOOTH_MIGRATION_MARKER" ]; then
        return 0
    fi

    # Retry the complete merge whenever the durable marker is absent. A prior
    # boot may have lost power after copying only part of the legacy bond
    # database; destination non-emptiness is not evidence of completion.
    if [ -n "$(ls -A "$BLUETOOTH_STATE_TARGET" 2>/dev/null)" ]; then
        if ! cp -a "$BLUETOOTH_STATE_TARGET"/. "$BLUETOOTH_STATE_SOURCE"/; then
            log "failed to migrate existing Bluetooth bonds"
            return 1
        fi
        sync
        log "migrated existing Bluetooth bonds to persistent storage"
    fi

    if ! touch "$BLUETOOTH_MIGRATION_MARKER"; then
        log "failed to record Bluetooth bond migration"
        return 1
    fi
    sync
    return 0
}

prepare_persistent_bluetooth_state() {
    if ! grep -qs '[[:space:]]/data[[:space:]]' /proc/mounts 2>/dev/null; then
        log "/data is not mounted; refusing to relocate Bluetooth bonds"
        return 1
    fi

    mkdir -p "$BLUETOOTH_STATE_SOURCE" "$BLUETOOTH_STATE_TARGET"
    chmod 700 "$BLUETOOTH_STATE_SOURCE" "$BLUETOOTH_STATE_TARGET" 2>/dev/null || true

    if grep -qs "[[:space:]]$BLUETOOTH_STATE_TARGET[[:space:]]" /proc/mounts 2>/dev/null; then
        # An earlier image may already have established the bind mount before
        # the one-time marker was introduced.
        if [ ! -e "$BLUETOOTH_MIGRATION_MARKER" ]; then
            if ! touch "$BLUETOOTH_MIGRATION_MARKER"; then
                log "failed to record existing Bluetooth bond migration"
                return 1
            fi
            sync
        fi
        log "persistent Bluetooth state already mounted"
        return 0
    fi

    # Preserve bonds created on a pre-migration image exactly once. The marker
    # must live outside BLUETOOTH_STATE_SOURCE: factory reset intentionally
    # empties that directory, and without a durable marker the underlying
    # rootfs copy would be imported again on the next boot.
    migrate_legacy_bluetooth_state || return 1

    if mount --bind "$BLUETOOTH_STATE_SOURCE" "$BLUETOOTH_STATE_TARGET" >>"$LOGFILE" 2>&1; then
        log "mounted persistent Bluetooth bonds at $BLUETOOTH_STATE_TARGET"
        return 0
    fi

    log "failed to bind persistent Bluetooth state"
    return 1
}

stop_bluetoothd() {
    if [ -x "$BLUETOOTHD_INIT" ]; then
        "$BLUETOOTHD_INIT" stop >>"$LOGFILE" 2>&1 || true
    fi
}

start_bluetoothd() {
    if ! prepare_persistent_bluetooth_state; then
        log "persistent Bluetooth state is unavailable; refusing to start bluetoothd"
        return 1
    fi
    if [ -x "$BLUETOOTHD_INIT" ] \
        && ! "$BLUETOOTHD_INIT" start >>"$LOGFILE" 2>&1; then
        log "failed to start bluetoothd"
        return 1
    fi
    return 0
}

start() {
    local readiness_status=0

    log "loading bluetooth modules"
    # Buildroot starts bluetoothd before this board-specific script. Stop it
    # before hci0 appears so BlueZ cannot probe a half-initialized UART
    # controller and leave the adapter absent for the rest of the boot.
    stop_bluetoothd
    modprobe bluetooth 2>/dev/null || true
    modprobe hci_uart 2>/dev/null || true
    sleep 1
    attach_controller || true
    sleep 1
    wait_for_hci_ready || readiness_status=$?
    if [ "$readiness_status" -ne 0 ]; then
        log_kernel_excerpt
        if [ "$readiness_status" -ne 2 ]; then
            return 1
        fi
        # A packaging regression must not leave bluetoothd stopped for the
        # entire boot. The image normally includes hciconfig for the active
        # readiness check; without it, preserve the legacy best-effort startup
        # and keep the degraded verification visible in bluetooth.log.
        log "starting bluetoothd without active controller readiness verification"
    fi
    if ! start_bluetoothd; then
        log_kernel_excerpt
        return 1
    fi
    log_kernel_excerpt
}

stop() {
    :
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        stop
        start
        ;;
esac
