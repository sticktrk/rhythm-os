<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rhythm.lighting.server</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/rhythm-server</string>
        <string>--data-dir</string>
        <string>__DATA_DIR__</string>
        <string>--log-level</string>
        <string>info</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>5</integer>

    <key>StandardOutPath</key>
    <string>__LOG_DIR__/rhythm-server.log</string>

    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/rhythm-server.err.log</string>
</dict>
</plist>
