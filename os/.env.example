# Home Assistant connection settings
HA_HOST=homeassistant.local
HA_PORT=8123
HA_TOKEN=your_long_lived_access_token_here
HA_USE_SSL=false

# Web server port (Light Designer UI)
INGRESS_PORT=8099

# OTA release upload settings for ./scripts/release.sh --upload
RHYTHM_UPDATES_SSH_HOST=
RHYTHM_UPDATES_SSH_USER=
RHYTHM_UPDATES_BASE_DIR=
# Prefer pointing at a local key file for upload mode
RHYTHM_UPDATES_SSH_KEY_FILE=
# Optional inline key fallback if you do not want to use a file path
# RHYTHM_UPDATES_SSH_KEY='-----BEGIN OPENSSH PRIVATE KEY-----
# ...
# -----END OPENSSH PRIVATE KEY-----'
