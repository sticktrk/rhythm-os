# Required.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional. Enables server-side reads of raw hub rows for legacy plaintext
# tokens. Client-side encrypted hub tokens still cannot be decrypted here.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional. Enables customer-granted beta admin support access for encrypted
# hub tokens and remote debug bundle collection.
SUPPORT_ACCESS_ENCRYPTION_KEY=shared-support-access-key
SUPPORT_ACCESS_KEY_ID=default

# Optional. Lets the repo-local nightly fleet scanner obtain its own short-lived
# staff session without requiring an interactive browser sign-in. Use a
# dedicated Supabase Auth user that has an enabled public.rhythm_staff row.
RHYTHM_ADMIN_EMAIL=fleet-automation@example.com
RHYTHM_ADMIN_PASSWORD=generate-and-store-locally

# Optional local server config.
ADMIN_API_HOST=127.0.0.1
ADMIN_API_PORT=8787
ADMIN_API_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
