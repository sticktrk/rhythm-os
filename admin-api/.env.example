# Required.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional. Enables server-side reads of raw hub rows for legacy plaintext
# tokens. Client-side encrypted hub tokens still cannot be decrypted here.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional local server config.
ADMIN_API_HOST=127.0.0.1
ADMIN_API_PORT=8787
ADMIN_API_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
