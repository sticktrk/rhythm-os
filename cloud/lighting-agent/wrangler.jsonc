{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rhythm-lighting-agent-pilot",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false,
  },
  "ai": {
    "binding": "AI",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CONVERSATIONS",
        "class_name": "LightingConversation",
      },
      {
        "name": "RESIDENT_INDEX",
        "class_name": "ConversationIndex",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LightingConversation", "ConversationIndex"],
    },
  ],
  "vars": {
    "ACCEPT_NEW_TURNS": "true",
    "PILOT_PERCENT": "0",
  },
}
