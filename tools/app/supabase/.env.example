# Optional Edge Function integrations. Copy only the settings you use to .env.
# Upload explicitly: supabase --workdir tools/app secrets set --env-file tools/app/supabase/.env
# Supabase supplies SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY.
# Never put this server configuration in a Flutter or browser environment file.

# Remote access: one Cloudflare account/zone/token and your DNS domain per project.
# RHYTHM_REMOTE_ACCESS_DOMAIN=devices.example.com
# CLOUDFLARE_ACCOUNT_ID=your-account-id
# CLOUDFLARE_ZONE_ID=your-zone-id
# CLOUDFLARE_API_TOKEN=your-tunnel-and-dns-token
# RHYTHM_REMOTE_ACCESS_ORIGIN=http://localhost:54448

# Optional GitHub support routing. Both destination and token are required.
# GITHUB_ISSUES_REPO=your-org/your-support-repo
# GITHUB_ISSUES_TOKEN=your-scoped-github-token

# Support access: reuse the same existing key as the staff Admin API.
# SUPPORT_ACCESS_ENCRYPTION_KEY=your-shared-support-key

# Monster: account email/password plus one vendor application credential per deployment.
# No per-device/per-customer secrets and no separate ticket-signing secret.
# MONSTER_EMAIL=your-dedicated-vendor-account@example.com
# MONSTER_PASSWORD=your-vendor-account-password
# MONSTER_AYLA_APP_SECRET=your-vendor-application-credential
# Optional: restrict this broker to one Supabase user instead of sharing it.
# MONSTER_OWNER_USER_ID=your-supabase-user-id
