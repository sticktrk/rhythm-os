# Local Admin API service configuration. Do not put staff-login or analytics
# credentials in this profile.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# `SUPABASE_SERVICE_KEY` remains an accepted legacy alias.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPPORT_ACCESS_ENCRYPTION_KEY=shared-support-access-key
SUPPORT_ACCESS_KEY_ID=default
ADMIN_API_HOST=127.0.0.1
ADMIN_API_PORT=8787
# `PORT` remains an accepted platform-provided fallback.
ADMIN_API_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
