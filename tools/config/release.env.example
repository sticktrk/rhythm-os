# Explicit local Cloudflare R2 OTA upload only. Normal GitHub Actions releases
# continue to use repository secrets.
CLOUDFLARE_ACCESS_KEY=your-r2-access-key-id
CLOUDFLARE_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_S3_API_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
CLOUDFLARE_R2_BUCKET=your-update-bucket
