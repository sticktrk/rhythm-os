# Flutter compile-time configuration. Never add server-side service-role,
# staff-login, analytics-personal, release-upload, or store credentials here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
GOOGLE_SIGN_IN_SERVER_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_DESKTOP_OAUTH_CLIENT_ID=your-desktop-client-id.apps.googleusercontent.com
GOOGLE_DESKTOP_OAUTH_SECRET=your-desktop-client-secret
LOGIN_ENABLED=true
AUX_SIGN_IN=true
# Legacy setting retained for config compatibility; tiers are suppressed in code.
ENTITLEMENTS_ENABLED=false
SHOW_ADVANCED_LIGHT_SECTION=false
REMOTE_ACCESS_TUNNEL_ENABLED=true
POSTHOG_API_KEY=phc_your-project-key
POSTHOG_HOST=https://us.i.posthog.com
