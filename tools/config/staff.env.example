# Read-only staff tooling. Use either an access token or the email/password pair.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Short-lived explicit token option:
# RHYTHM_ADMIN_ACCESS_TOKEN=your-short-lived-staff-token

# Dedicated enabled Rhythm staff account option:
RHYTHM_ADMIN_EMAIL=fleet-automation@example.com
RHYTHM_ADMIN_PASSWORD=generate-and-store-locally
