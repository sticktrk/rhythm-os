# Supabase credentials
# Copy this file to .env and fill in your values
# Get these from: Supabase Dashboard > Settings > API

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Google OAuth for macOS (Desktop-type client)
# Get these from: Google Cloud Console > APIs & Services > Credentials
GOOGLE_WEB_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_WEB_OAUTH_SECRET=your-client-secret

# Feature flags
# Set to false to hide login/signup for App Store review builds
LOGIN_ENABLED=true

# PostHog Analytics
# Get your API key from: PostHog > Project Settings > Project API Key
POSTHOG_API_KEY=phc_your_api_key
POSTHOG_HOST=https://us.i.posthog.com
