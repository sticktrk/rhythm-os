# Supabase credentials
# Copy this file to .env and fill in your values
# Get these from: Supabase Dashboard > Settings > API

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Google Sign-In for Android/iOS.
# Must be a Web OAuth client ID, not an Android/iOS/Desktop client ID.
# Get these from: Google Cloud Console > APIs & Services > Credentials
GOOGLE_SIGN_IN_SERVER_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Google OAuth for macOS manual sign-in.
# Must be a Desktop OAuth client because the app uses loopback redirects.
GOOGLE_DESKTOP_OAUTH_CLIENT_ID=your-desktop-client-id.apps.googleusercontent.com
GOOGLE_DESKTOP_OAUTH_SECRET=your-desktop-client-secret

# Feature flags
# Set to false to hide login/signup for App Store review builds
LOGIN_ENABLED=true

# PostHog Analytics
# Get your API key from: PostHog > Project Settings > Project API Key
POSTHOG_API_KEY=phc_your_api_key
POSTHOG_HOST=https://us.i.posthog.com

# Subscription tiers are suppressed in code; this legacy setting is ignored.
ENTITLEMENTS_ENABLED=false
