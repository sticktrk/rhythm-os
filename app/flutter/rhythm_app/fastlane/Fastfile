require "json"
require "fileutils"
require "tmpdir"
require_relative "apple_release_status"

min_fastlane_version("2.237.0")

APP_IDENTIFIER = "lighting.rhythm.app"
DEFAULT_ASC_API_KEY_PATH = File.expand_path("~/.config/rhythm/asc_api_key.json")
DEFAULT_GOOGLE_PLAY_KEY_PATH = File.expand_path("~/.config/rhythm/google_play_key.json")
DEFAULT_REVIEW_CONFIG_PATH = File.expand_path("~/.config/rhythm/app_store_review.json")

def read_json(path, label)
  UI.user_error!("#{label} not found: #{path}") unless File.file?(path)
  JSON.parse(File.read(path))
rescue JSON::ParserError => error
  UI.user_error!("#{label} is not valid JSON: #{error.message}")
end

def release_plan(options)
  path = File.expand_path(options[:plan].to_s)
  UI.user_error!("Pass plan:/absolute/path/to/release-plan.json") if options[:plan].to_s.empty?
  plan = read_json(path, "Release plan")
  plan["_path"] = path
  plan
end

def require_string(hash, key, label)
  value = hash[key].to_s.strip
  UI.user_error!("#{label} must set #{key}") if value.empty?
  value
end

def validate_common_plan(plan)
  version = require_string(plan, "version", "Release plan")
  require_string(plan, "source_commit", "Release plan")
  notes = plan["release_notes"]
  UI.user_error!("Release plan must contain release_notes by locale") unless notes.is_a?(Hash) && !notes.empty?
  notes.each do |locale, text|
    UI.user_error!("Release notes locale cannot be empty") if locale.to_s.strip.empty?
    UI.user_error!("Release notes for #{locale} cannot be empty") if text.to_s.strip.empty?
  end
  version
end

def asc_api_key_path
  File.expand_path(ENV.fetch("RHYTHM_ASC_API_KEY_PATH", DEFAULT_ASC_API_KEY_PATH))
end

def google_play_key_path
  File.expand_path(ENV.fetch("RHYTHM_GOOGLE_PLAY_JSON_KEY_PATH", DEFAULT_GOOGLE_PLAY_KEY_PATH))
end

def review_config_path
  File.expand_path(ENV.fetch("RHYTHM_APP_REVIEW_CONFIG_PATH", DEFAULT_REVIEW_CONFIG_PATH))
end

def validate_ios_candidate(plan)
  version = validate_common_plan(plan)
  apple = plan["apple"]
  UI.user_error!("Release plan must contain apple settings") unless apple.is_a?(Hash)
  build_number = require_string(apple, "build_number", "Apple release plan")
  UI.user_error!("Apple build_number must be numeric") unless build_number.match?(/\A[0-9]+\z/)

  key_path = asc_api_key_path
  UI.user_error!("App Store Connect API key not found: #{key_path}") unless File.file?(key_path)
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from_json_file(key_path)

  app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
  UI.user_error!("App Store Connect app not found: #{APP_IDENTIFIER}") unless app

  builds = Spaceship::ConnectAPI::Build.all(
    app_id: app.id,
    version: version,
    build_number: build_number,
    platform: "IOS"
  )
  UI.user_error!("Apple build #{version} (#{build_number}) was not found") if builds.empty?

  build = builds.first
  unless build.processing_state == Spaceship::ConnectAPI::Build::ProcessingState::VALID
    UI.user_error!("Apple build #{version} (#{build_number}) is #{build.processing_state}, not VALID")
  end

  live_version = app.get_live_app_store_version(platform: "IOS")
  if live_version && Gem::Version.new(live_version.version_string) >= Gem::Version.new(version)
    UI.user_error!("Apple #{version} is not newer than live version #{live_version.version_string}")
  end

  in_review_version = app.get_in_review_app_store_version(platform: "IOS")
  if in_review_version
    UI.user_error!("Apple already has version #{in_review_version.version_string} in review")
  end

  edit_version = app.get_edit_app_store_version(platform: "IOS")
  if edit_version && edit_version.version_string != version
    UI.user_error!("Apple editable version #{edit_version.version_string} conflicts with planned version #{version}")
  end
  if edit_version && edit_version.app_version_state == "WAITING_FOR_REVIEW"
    UI.user_error!("Apple version #{version} is already waiting for review")
  end

  UI.success("Apple candidate verified: #{version} (#{build_number}), processing state VALID")
  { version: version, build_number: build_number }
end

def validate_android_candidate(plan)
  version = validate_common_plan(plan)
  android = plan["google_play"]
  UI.user_error!("Release plan must contain google_play settings") unless android.is_a?(Hash)
  version_code = require_string(android, "version_code", "Google Play release plan")
  source_track = require_string(android, "source_track", "Google Play release plan")
  UI.user_error!("Google Play version_code must be numeric") unless version_code.match?(/\A[0-9]+\z/)

  key_path = google_play_key_path
  UI.user_error!("Google Play service-account key not found: #{key_path}") unless File.file?(key_path)

  codes = google_play_track_version_codes(
    package_name: APP_IDENTIFIER,
    track: source_track,
    json_key: key_path
  ).map(&:to_s)
  unless codes.include?(version_code)
    UI.user_error!("Google Play #{source_track} does not contain version code #{version_code}; found #{codes.inspect}")
  end

  release_names = google_play_track_release_names(
    package_name: APP_IDENTIFIER,
    track: source_track,
    json_key: key_path
  ).map(&:to_s)
  unless release_names.include?(version)
    UI.user_error!("Google Play #{source_track} does not contain release name #{version}; found #{release_names.inspect}")
  end

  production_codes = google_play_track_version_codes(
    package_name: APP_IDENTIFIER,
    track: "production",
    json_key: key_path
  ).map(&:to_s)
  if production_codes.include?(version_code)
    UI.user_error!("Google Play production already contains version code #{version_code}")
  end

  UI.success("Google Play candidate verified: #{version} (#{version_code}) on #{source_track}")
  { version: version, version_code: version_code, source_track: source_track }
end

def app_review_information(plan)
  config = read_json(review_config_path, "App Store review configuration")
  required = %w[first_name last_name phone_number email_address demo_user demo_password]
  missing = required.select { |key| config[key].to_s.strip.empty? }
  UI.user_error!("App Store review configuration is missing: #{missing.join(', ')}") unless missing.empty?

  stable_notes_path = File.join(__dir__, "review-notes.txt")
  stable_notes = File.read(stable_notes_path).strip
  release_notes = plan.dig("apple", "review_notes").to_s.strip
  config["notes"] = [stable_notes, release_notes].reject(&:empty?).join("\n\n")
  config
end

def connect_to_app_store
  key_path = asc_api_key_path
  UI.user_error!("App Store Connect API key not found: #{key_path}") unless File.file?(key_path)
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from_json_file(key_path)
  app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
  UI.user_error!("App Store Connect app not found: #{APP_IDENTIFIER}") unless app
  app
end

def write_google_play_metadata(plan, version_code, root)
  plan["release_notes"].each do |locale, notes|
    changelog_dir = File.join(root, locale, "changelogs")
    FileUtils.mkdir_p(changelog_dir)
    File.write(File.join(changelog_dir, "#{version_code}.txt"), notes.to_s.strip + "\n")
  end
end

def apple_release_status(plan)
  app = connect_to_app_store
  version = plan.fetch("version")
  build_number = plan.dig("apple", "build_number").to_s
  RhythmAppleReleaseStatus.read(app: app, version: version, build_number: build_number)
end

def google_play_release_status(plan)
  require "supply"
  require "supply/options"
  require "supply/reader"

  version = plan.fetch("version")
  version_code = plan.dig("google_play", "version_code").to_s
  Supply.config = FastlaneCore::Configuration.create(
    Supply::Options.available_options,
    {
      package_name: APP_IDENTIFIER,
      track: "production",
      json_key: google_play_key_path
    }
  )
  track = Supply::Reader.new.track_meta
  release = track&.releases&.find do |candidate|
    Array(candidate.version_codes).map(&:to_s).include?(version_code)
  end

  {
    version: version,
    version_code: version_code,
    raw_state: release ? release.status.to_s : "MISSING",
    rollout: release&.user_fraction
  }
end

desc "Read-only validation of an exact Apple and/or Google Play production candidate"
lane :app_release_preflight do |options|
  plan = release_plan(options)
  requested_platform = options[:platform].to_s
  requested_platform = "all" if requested_platform.empty?
  UI.user_error!("platform must be ios, android, or all") unless %w[ios android all].include?(requested_platform)

  if %w[ios all].include?(requested_platform)
    validate_ios_candidate(plan)
    app_review_information(plan)
    UI.success("App Store review contact, demo account, and reviewer notes are complete")
  end
  validate_android_candidate(plan) if %w[android all].include?(requested_platform)
  UI.success("Production release preflight passed for #{requested_platform}")
end

desc "Read the raw Apple and/or Google production state for one exact release plan"
lane :app_release_status do |options|
  plan = release_plan(options)
  requested_platform = options[:platform].to_s
  requested_platform = "all" if requested_platform.empty?
  UI.user_error!("platform must be ios, android, or all") unless %w[ios android all].include?(requested_platform)
  output_path = File.expand_path(options[:output].to_s)
  UI.user_error!("Pass output:/absolute/path/status.json") if options[:output].to_s.empty?

  status = {}
  status[:ios] = apple_release_status(plan) if %w[ios all].include?(requested_platform)
  status[:android] = google_play_release_status(plan) if %w[android all].include?(requested_platform)
  FileUtils.mkdir_p(File.dirname(output_path))
  File.write(output_path, JSON.pretty_generate(status) + "\n")
  File.chmod(0o600, output_path)
  UI.success("Production release status written to #{output_path}")
end

desc "Export existing App Store review contact and demo fields to a mode-0600 local JSON file"
lane :app_release_export_review_config do |options|
  output_path = File.expand_path(options[:output].to_s)
  UI.user_error!("Pass output:/absolute/path/app_store_review.json") if options[:output].to_s.empty?

  app = connect_to_app_store
  version = app.get_edit_app_store_version(platform: "IOS") ||
            app.get_live_app_store_version(platform: "IOS")
  UI.user_error!("No editable or live iOS App Store version was found") unless version
  detail = version.fetch_app_store_review_detail
  UI.user_error!("No App Store review information exists for version #{version.version_string}") unless detail

  config = {
    "first_name" => detail.contact_first_name,
    "last_name" => detail.contact_last_name,
    "phone_number" => detail.contact_phone,
    "email_address" => detail.contact_email,
    "demo_user" => detail.demo_account_name,
    "demo_password" => detail.demo_account_password
  }
  missing = config.select { |_key, value| value.to_s.strip.empty? }.keys
  UI.important("Exported config still needs values for: #{missing.join(', ')}") unless missing.empty?

  FileUtils.mkdir_p(File.dirname(output_path))
  File.write(output_path, JSON.pretty_generate(config) + "\n")
  File.chmod(0o600, output_path)
  UI.success("Exported App Store review configuration for #{version.version_string} to #{output_path}")
end

desc "Select an exact processed TestFlight build and submit it to Apple App Review"
lane :app_release_submit_ios do |options|
  plan = release_plan(options)
  candidate = validate_ios_candidate(plan)
  apple = plan["apple"]

  deliver(
    api_key_path: asc_api_key_path,
    app_identifier: APP_IDENTIFIER,
    platform: "ios",
    app_version: candidate[:version],
    build_number: candidate[:build_number],
    submit_for_review: true,
    automatic_release: apple.fetch("automatic_release", false),
    phased_release: apple.fetch("phased_release", true),
    skip_binary_upload: true,
    skip_screenshots: true,
    force: true,
    # API-key auth cannot inspect in-app purchases during Fastlane precheck;
    # App Store Connect still validates them as part of the submission.
    precheck_include_in_app_purchases: false,
    release_notes: plan["release_notes"],
    app_review_information: app_review_information(plan),
    submission_information: {
      export_compliance_uses_encryption: false,
      content_rights_contains_third_party_content: false
    }
  )
end

desc "Promote one exact internal-testing build to a staged Google Play production release"
lane :app_release_submit_android do |options|
  plan = release_plan(options)
  candidate = validate_android_candidate(plan)
  android = plan["google_play"]
  rollout = android.fetch("rollout", 0.1).to_f
  UI.user_error!("Google Play rollout must be greater than 0 and at most 1") unless rollout > 0 && rollout <= 1

  Dir.mktmpdir("rhythm-google-play-metadata.") do |metadata_path|
    write_google_play_metadata(plan, candidate[:version_code], metadata_path)
    upload_to_play_store(
      package_name: APP_IDENTIFIER,
      json_key: google_play_key_path,
      track: candidate[:source_track],
      track_promote_to: "production",
      version_code: candidate[:version_code],
      track_promote_release_status: rollout < 1 ? "inProgress" : "completed",
      rollout: rollout.to_s,
      metadata_path: metadata_path,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: false,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      changes_not_sent_for_review: false
    )
  end
end
