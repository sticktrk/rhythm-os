# Home Assistant connection settings
HA_HOST=homeassistant.local
HA_PORT=8123
HA_TOKEN=your_long_lived_access_token_here
HA_USE_SSL=false

# Web server port (Light Designer UI)
INGRESS_PORT=8099

# Flutter web directory (optional - defaults to dist/flutter_web)
# FLUTTER_WEB_DIR=/path/to/flutter/web/build

# Apple Sign In OAuth (for generate-apple-secret.sh)
# APPLE_TEAM_ID=ABC123XYZ
# APPLE_KEY_ID=XXXXXXXXXX
# APPLE_SERVICE_ID=com.yourapp.service
# APPLE_KEY_FILE=AuthKey_XXXXXXXXXX.p8
# APPLE_SECRET_EXPIRY=180
