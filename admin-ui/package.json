{
  "name": "rhythm-admin-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check:device-admin-coverage && npm run check:profile-curve-data && npm run check:node-light-settings && npm run test:topology-membership && tsc --noEmit && vite build",
    "check:device-admin-coverage": "node scripts/check-device-admin-coverage.mjs",
    "check:profile-curve-data": "node scripts/check-profile-curve-data.mjs",
    "check:node-light-settings": "node scripts/check-node-light-settings.mjs",
    "test:mode-write-payload": "node --experimental-strip-types --test test/modeWritePayload.test.ts",
    "test:topology-membership": "node --experimental-strip-types --test test/topologyMembership.test.ts",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.0"
  }
}
