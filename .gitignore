.DS_Store

# Python bytecode generated by repo-local Codex skill helpers.
__pycache__/
*.py[cod]

# Local Dart analysis/cache folders found at the app repo root.
app/.dart-tool/
app/.dartServer/

# Local backups of the pre-monorepo git metadata for os/app/sdk.
.repo-git-backups/

# Local working-tree backups made during monorepo import.
.repo-working-backups/

# Temporary history-filtered import clones.
.repo-import-work/

# Rust workspace build output.
target/

# Downloaded/extracted app bug-report debug bundles (see /triage).
.triage/

.release-evidence/
admin-api/.env

# Local assistant/worktree scratch state.
.claude/worktrees/

# Local Supabase CLI project metadata.
tools/app/supabase/.temp/
tools/app/supabase/.env

# Marketing site: its own repo (sticktrk/rhythm-marketing), worked on in place, deployed standalone to prod.
/rhythm-marketing/

# CHIP checkout
/connectedhomeip/

# Private development material and generated runtime traces.
.codex/
.claude/
.triage/
**/flutter_log.txt
**/.firebase/
**/.firebaserc
**/.env
**/.env.*
!**/.env.example
**/*.p12
**/*.p8
**/*.jks
**/*.keystore

# Generated web bindings and binaries may embed local build paths.
